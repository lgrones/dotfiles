                {
                    "idleAction": "dpms off",
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 300
                }
            ]
        }
    },
    "launcher": {
        "actions": [
            {
                "command": [
                    "autocomplete",
